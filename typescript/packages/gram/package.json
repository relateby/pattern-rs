{
  "name": "@relateby/gram",
  "version": "0.7.1",
  "description": "Gram notation codec for relateby",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/relateby/pattern-rs.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "browser": "./dist/index-browser.js",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "wasm",
    "wasm-node"
  ],
  "scripts": {
    "build:wasm": "wasm-pack build ../../../adapters/wasm/pattern-wasm --target bundler --out-dir ../../../typescript/packages/gram/wasm",
    "build:wasm:node": "wasm-pack build ../../../adapters/wasm/pattern-wasm --target nodejs --out-dir ../../../typescript/packages/gram/wasm-node",
    "build:ts": "tsc",
    "build:assets": "rm -rf dist/wasm dist/wasm-node && cp -R wasm dist/wasm && cp -R wasm-node dist/wasm-node && rm -f dist/wasm/.gitignore dist/wasm-node/.gitignore",
    "build": "npm run build:wasm && npm run build:wasm:node && npm run build:ts && npm run build:assets",
    "test": "vitest run",
    "pack:release": "npm pack --pack-destination ../../../target/npm-packages",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@relateby/pattern": "0.7.1"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  },
  "overrides": {
    "why-is-node-running": "3.2.2"
  }
}
